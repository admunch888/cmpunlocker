diff --git a/src/nvidia/src/kernel/gpu/gpu.c b/src/nvidia/src/kernel/gpu/gpu.c
--- a/src/nvidia/src/kernel/gpu/gpu.c
+++ b/src/nvidia/src/kernel/gpu/gpu.c
@@ -2516,6 +2516,22 @@ _gpuInitPcieP2PCapability
 
     pGpu->pcieP2PReadCaps = p2pCapsParams.p2pReadCapsStatus;
     pGpu->pcieP2PWriteCaps = p2pCapsParams.p2pWriteCapsStatus;
+
+    // CMP 170HX/220HX GSP firmware reports PCIe peer access as unsupported
+    // even when the host topology and BAR1 path can carry it. This patch is
+    // applied only for an explicit --p2p build; keep every other device and
+    // the default build on the firmware-reported values.
+    {
+        NvU32 cmpDevId = pGpu->idInfo.PCIDeviceID >> 16;
+        if ((cmpDevId == 0x20C2) || (cmpDevId == 0x2082))
+        {
+            pGpu->pcieP2PReadCaps = 0;
+            pGpu->pcieP2PWriteCaps = 0;
+            NV_PRINTF(LEVEL_ERROR,
+                      "CMPUNLOCK_P2P: GSP PCIe peer caps forced to OK (devId=0x%x)\n",
+                      cmpDevId);
+        }
+    }
 }
 
 static void
