[Unit]
Description=CMP 170HX early-boot PCIe Gen2 retrain
DefaultDependencies=no
After=sysinit.target
Before=basic.target multi-user.target graphical.target
ConditionPathExists=/usr/local/sbin/gen2-hammer

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gen2-hammer
#
# gen2-hammer retrains every card concurrently and gives each one this budget,
# so the run costs about one card's budget no matter how many are installed.
# TimeoutStartSec is kept well above it: this unit blocks boot, and a timeout
# kills the retrain mid-flight rather than letting it report and exit cleanly.
#
Environment=CMP170HX_GEN2_CARD_DEADLINE=20
TimeoutStartSec=60
RemainAfterExit=no

[Install]
WantedBy=sysinit.target
